# Copy to .env.local and fill in. All keys are read server-side only (Next.js route handlers).
# Never prefix these with NEXT_PUBLIC_.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs key: https://elevenlabs.io/app/settings/api-keys (needs Text to Speech + Voices read)
ELEVENLABS_API_KEY=

# Spoonacular key: https://spoonacular.com/food-api/console (free plan = 50 points/day)
SPOONACULAR_API_KEY=

# ---- Optional overrides ----
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.8-flash
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_DEFAULT_VOICE_ID=
# Set to 1 to skip live Spoonacular calls and serve only the cached recipes (saves quota on demo day)
# SOUS_FORCE_CACHE=0
